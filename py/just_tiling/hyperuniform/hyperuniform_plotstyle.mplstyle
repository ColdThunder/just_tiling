
### LINES
lines.linewidth : 1.5
lines.markersize : 10

### FONT
font.size : 20.0
#font.family : serif
#font.family : sans-serif
#font.family : cursive
#font.family : fantasy
#font.family : monospace

### AXES
#axes.titlesize : xx-large
#axes.labelsize : xx-large
axes.linewidth : 2
axes.grid : True

### TICKS
xtick.major.size : 8
xtick.minor.size : 4
ytick.major.size : 8
ytick.minor.size : 4
xtick.major.width : 2
xtick.minor.width : 1
ytick.major.width : 2
ytick.minor.width : 1
xtick.direction : in
ytick.direction : in

#xtick.labelsize : xx-large
#ytick.labelsize : xx-large

### LEGEND
#legend.fontsize : xx-large

### FIGURE
figure.figsize : 8, 5.5   

### SAVEFIG
savefig.transparent : True
